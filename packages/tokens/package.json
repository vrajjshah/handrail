{
  "name": "@handrail/tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The design tokens every Handrail surface is built from, and the contrast maths that proves they are legible.",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./theme.css"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./theme.css": "./theme.css"
    }
  },
  "files": ["dist", "theme.css"],
  "scripts": {
    "tokens:build": "tsx src/scripts/build-tokens.ts"
  }
}
