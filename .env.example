# Handrail server configuration.
#
# This file is the contract: `config.test.ts` fails if a variable exists in
# `ConfigSchema` and not here, so a deploy cannot depend on something a
# developer's machine has never heard of.
#
# Copy to `.env` and edit. Nothing here has a secret default — a missing
# credential fails at boot, naming the variable, rather than at the first
# request that needed it.

# Which half of the image this process is. One image, two roles.
#   api    — serves HTTP only
#   worker — runs scans only
#   both   — a single process doing each (the local default)
SERVICE_ROLE=both

HOST=0.0.0.0
PORT=8080

# How the API refers to itself: generated links and the OpenAPI servers list.
PUBLIC_URL=http://localhost:8080

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

NODE_ENV=development

# Postgres. Optional: without it the server holds scans in memory and says so
# at boot rather than looking durable. A hosted deployment always sets it.
#
# Migrations are an explicit pre-start step, never run on boot:
#   pnpm --filter @handrail/server db:migrate
DATABASE_URL=postgresql://handrail:handrail@localhost:5433/handrail

# How long a worker may hold a scan job before the queue assumes it died.
# Must exceed the longest scan the budget permits (10 minutes).
JOB_EXPIRE_SECONDS=900

# 1 or 2. A scan drives a real browser, so the limit is memory, not throughput.
WORKER_CONCURRENCY=1

# Bypasses the rate limits, for the demo and for debugging a report. Unset by
# default and never given a default value — an admin token with a default is a
# published credential. At least 32 characters, sent as `X-Admin-Token`.
# ADMIN_TOKEN=
