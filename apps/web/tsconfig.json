{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./.tsbuild",
    "tsBuildInfoFile": "./.tsbuild/.tsbuildinfo",

    // A bundler owns resolution here, not Node. `NodeNext` would reject the
    // extensionless imports Vite expects and refuse the `.css` side-effect
    // import entirely, so this is the one package that deviates from the base.
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "references": [{ "path": "../../packages/schemas" }, { "path": "../../packages/tokens" }]
}
