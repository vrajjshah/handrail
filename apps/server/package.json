{
  "name": "@handrail/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The hosted Handrail API: submit a scan, stream its events, read the evidence report.",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "smoke": "tsx src/scripts/smoke-main.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@fastify/static": "^10.1.2",
    "@fastify/swagger": "^9.8.1",
    "@handrail/engine": "workspace:*",
    "@handrail/orchestrator": "workspace:*",
    "@handrail/schemas": "workspace:*",
    "@handrail/wcag": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "fastify-type-provider-zod": "^7.0.0",
    "openapi-types": "^12.1.3",
    "pg": "^8.22.0",
    "pg-boss": "^12.26.3",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1"
  }
}
